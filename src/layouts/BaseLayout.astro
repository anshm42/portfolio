---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Ansh Maru is a Computational Mathematics student at the University of Waterloo interested in ML, AI, and backend software engineering.',
} = Astro.props;

const path = Astro.url.pathname;
const links = [
  ['work', '/work'],
  ['about', '/about'],
  ['listening', '/listening'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="filebar shell">
      <a class="filename" href="/" aria-label="Ansh Maru, home">
        <span aria-hidden="true">●</span> Ansh Maru
      </a>

      <nav aria-label="Primary navigation">
        {links.map(([label, href]) => (
          <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
        <span class="nav-muted">resume.todo</span>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <span aria-hidden="true">◐</span>
      </button>
    </header>

    <main id="main" class="document shell">
      <slot />
    </main>

    <footer class="site-footer shell">
      <div>
        <a href="mailto:amaru@uwaterloo.ca">email</a>
        <a href="https://github.com/anshm42">github</a>
        <a href="https://www.linkedin.com/in/anshmaru">linkedin</a>
      </div>
      <p>© 2026 Ansh Maru</p>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
        themeColor?.setAttribute('content', theme === 'dark' ? '#191a18' : '#f7f6f2');
      };

      button?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    </script>
  </body>
</html>
