---
import BaseLayout from '../layouts/BaseLayout.astro';

const artists = ['Sade', 'The Weeknd', 'Brent Faiyaz', "Pz'"];
---

<BaseLayout title="Listening — Ansh Maru" description="What Ansh Maru is listening to right now.">
  <article class="markdown page">
    <p class="breadcrumb"><a href="/">Ansh Maru</a> / listening</p>
    <h1>Listening</h1>
    <p>A small log of what has been in rotation lately.</p>

    <h2>Artists right now</h2>
    <ul class="listening-list">
      {artists.map((artist) => <li>{artist}</li>)}
    </ul>

    <blockquote>Favorite song picks will replace this note once the list is ready.</blockquote>
  </article>
</BaseLayout>
