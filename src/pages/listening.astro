---
import BaseLayout from '../layouts/BaseLayout.astro';


const tracks = [
  'https://open.spotify.com/embed/track/2UgTHKJFCYqQ7CGmmslDeC?utm_source=generator&theme=0&si=7b2f41ae887048ed',
  'https://open.spotify.com/embed/track/3RR6mToN9kcf2ESbzSCtJk?utm_source=generator&theme=0&si=17a86ee2a04440b1',
  'https://open.spotify.com/embed/track/5yqRtfOflVdoWcAAeHyUwc?utm_source=generator&theme=0&si=1abf714e742f4aee',
  'https://open.spotify.com/embed/track/4xkTT5tj3xlbJ4feaIXEv2?theme=0',
  'https://open.spotify.com/embed/track/6MF5JoJYj5uK07Si6fRAPM?theme=0',
  'https://open.spotify.com/embed/track/2p8IUWQDrpjuFltbdgLOag?theme=0',
  'https://open.spotify.com/embed/track/2v0AG62ZHtD3I4YmTb3WYM?theme=0',
  'https://open.spotify.com/embed/track/0E0DRHf5PfMeor0ZCwB3oT?theme=0',
  'https://open.spotify.com/embed/track/4tReFKumS5bcFahdXDiM1b?theme=0',
];
---

<BaseLayout title="Listening — Ansh Maru" description="What Ansh Maru is listening to right now.">
  <article class="markdown page">
    <p class="breadcrumb"><a href="/">Ansh Maru</a> / listening</p>
    <h1>Listening</h1>
    <p>A small log of what has been in rotation lately.</p>


    <h2>Song picks</h2>
    <div class="song-embeds">
      {tracks.map((track, index) => (
        <iframe
          class="spotify-embed"
          src={track}
          title={`Spotify song pick ${index + 1}`}
          width="100%"
          height="152"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      ))}
    </div>
  </article>
</BaseLayout>
