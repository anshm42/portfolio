---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Work — Ansh Maru" description="Projects and technical work by Ansh Maru.">
  <article class="markdown page">
    <p class="breadcrumb"><a href="/">Ansh Maru</a> / work</p>
    <h1>Work</h1>
    <p>Selected projects, implementation details, and measurable outcomes.</p>

    <div class="project-entries">
      {projects.map((project, index) => (
        <section class="project-entry" id={project.slug}>
          <header>
            <div>
              <span>0{index + 1}</span>
              <h2>{project.name}</h2>
            </div>
            <a href={project.github} target="_blank" rel="noreferrer">github ↗</a>
          </header>
          <p class="project-stack">{project.stack}</p>
          <p>{project.impact}</p>
          <ul>
            {project.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
