---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Work — Ansh Maru" description="Projects and technical work by Ansh Maru.">
  <article class="markdown page">
    <p class="breadcrumb"><a href="/">Ansh Maru</a> / work</p>
    <h1>Work</h1>
    <!-- <p>Work experience, selected projects, and measurable outcomes.</p> -->

    <h2 id="work-history">Work history</h2>
    <section class="experience-entry">
      <header>
        <div>
          <h3>Patents &amp; Innovation Intern</h3>
          <p>Pratt &amp; Whitney Canada · Mississauga, Ontario</p>
        </div>
        <time>Sept 2025 — Dec 2025</time>
      </header>
      <ul>
        <li>Researched electronic engine control systems to support future projects.</li>
        <li>Collaborated with the engine controls team on embedded software and hardware security research.</li>
        <li>Deployed an internal Power BI dashboard used by a cross-functional team of more than 30 members.</li>
      </ul>
    </section>

    <h2>Projects</h2>
    <div class="project-entries">
      {projects.map((project, index) => (
        <section class="project-entry" id={project.slug}>
          <header>
            <div>
              <span>0{index + 1}</span>
              <h2>{project.name}</h2>
            </div>
            <a class="repo-link" href={project.github} target="_blank" rel="noreferrer" aria-label={`View ${project.name} on GitHub`} title="View on GitHub">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
            </a>
          </header>
          <p class="project-stack">{project.stack}</p>
          <p>{project.impact}</p>
          <ul>
            {project.details.map((detail) => <li>{detail}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
