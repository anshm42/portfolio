---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Ansh Maru — Computational Mathematics">
  <article class="markdown page home">
    <header>
      <!-- <p class="eyebrow">Ansh Maru · Milton, Ontario</p> -->
      <h1>Hi, I’m Ansh!</h1>
      <p>
        I'm a Computational Mathematics student at the University of Waterloo,
        interested in software engineering, particularly <code>ML / AI</code> and
        <code>backend systems</code>, as well as the intersection of software engineering and aviation + motorsport
      </p>
        <p>Outside of that, I love music, history, and soccer.</p>
    </header>

    <ul class="resume-points">
      <li>
        math @ loo
        <img src="/uwaterloo.svg" alt="" title="University of Waterloo" />
      </li>
      <li>
        Built:
        <ul class="home-projects">
          {projects.map((project) => (
            <li>
              <div>
                <a href={`/work#${project.slug}`}>{project.name}</a>
                <a class="repo-link" href={project.github} target="_blank" rel="noreferrer">github ↗</a>
              </div>
              <p>{project.impact}</p>
            </li>
          ))}
        </ul>
      </li>
      <li>prev @ Pratt &amp; Whitney Canada</li>
    </ul>

  </article>
</BaseLayout>
