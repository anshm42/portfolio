---
import '../styles/global.css';

const projects = [
  {
    number: '01',
    title: 'Your strongest project',
    summary: 'The clearest example of software you designed, built, and finished.',
    stack: 'TypeScript · React',
  },
  {
    number: '02',
    title: 'A technical challenge',
    summary: 'Architecture, algorithms, or a difficult engineering tradeoff.',
    stack: 'Python · PostgreSQL',
  },
  {
    number: '03',
    title: 'Math meets software',
    summary: 'A project connecting mathematics to practical computation.',
    stack: 'Python · Data',
  },
  {
    number: '04',
    title: 'A curious experiment',
    summary: 'Something personal that shows how you explore and learn.',
    stack: 'Your tools',
  },
];

const music = [
  ['01', 'Album title', 'Artist'],
  ['02', 'Album title', 'Artist'],
  ['03', 'Album title', 'Artist'],
  ['04', 'Album title', 'Artist'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A mathematics student pursuing software engineering."
    />
    <meta name="theme-color" content="#f4f2eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Mathematics → Software Engineering</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="identity" href="#top" aria-label="Home">
        <strong>YN</strong>
        <span>Mathematics student</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a href="#music">Music</a>
        <a href="#resume">Résumé ↗</a>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <span class="theme-toggle__sun" aria-hidden="true">○</span>
        <span class="theme-toggle__moon" aria-hidden="true">●</span>
      </button>
    </header>

    <main id="main">
      <section class="hero shell" id="top">
        <p class="kicker">Your Name · Mathematics student</p>
        <h1>I’m interested in software engineering and building things that work well.</h1>
        <p class="hero__intro">
          I use mathematical reasoning to approach unfamiliar problems with clarity,
          then turn those ideas into practical software.
        </p>
        <div class="hero__footer">
          <div class="hero__actions">
            <a class="text-link" href="#work">Selected work <span>↓</span></a>
            <a class="text-link" href="mailto:you@example.com">Email <span>↗</span></a>
          </div>
          <p class="availability"><span></span> Open to opportunities</p>
        </div>
      </section>

      <section class="section shell" id="work">
        <header class="section-heading">
          <p><span>01</span> Selected work</p>
          <span>4 projects</span>
        </header>

        <div class="projects">
          {projects.map((project) => (
            <article class="project">
              <p class="project__number">{project.number}</p>
              <div>
                <h2>{project.title}</h2>
                <p>{project.summary}</p>
              </div>
              <p class="project__stack">{project.stack}</p>
              <a href="#contact" aria-label={`View ${project.title}`}>↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section split-section shell" id="experience">
        <div>
          <header class="section-heading"><p><span>02</span> Experience</p></header>
          <article class="timeline-item">
            <time>20XX—NOW</time>
            <div><h2>Your role</h2><p>Company or organisation</p><p>Describe what you contributed and the result, not just the tasks you were given.</p></div>
          </article>
          <article class="timeline-item muted-item">
            <time>20XX</time>
            <div><h2>Another relevant role</h2><p>Company or organisation</p></div>
          </article>
        </div>

        <div>
          <header class="section-heading"><p><span>03</span> Education</p></header>
          <article class="timeline-item">
            <time>20XX—20XX</time>
            <div><h2>BSc Mathematics</h2><p>Your university</p><p>Probability · Statistics · Numerical methods · Graph theory</p></div>
          </article>
        </div>
      </section>

      <section class="section about shell" id="about">
        <header class="section-heading"><p><span>04</span> About</p></header>
        <div class="about__layout">
          <p class="about__lead">I like problems that need both careful reasoning and practical execution.</p>
          <div class="about__body">
            <p>
              Use this space to explain how mathematics shapes the way you build software:
              breaking down unfamiliar problems, reasoning precisely, and communicating complex ideas clearly.
            </p>
            <dl>
              <div><dt>Focus</dt><dd>Your engineering interests</dd></div>
              <div><dt>Currently</dt><dd>What you are learning</dd></div>
              <div><dt>Location</dt><dd>Your city or region</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="section music shell" id="music">
        <header class="section-heading"><p><span>05</span> Currently in rotation</p><span>After-hours listening</span></header>
        <div class="music-list">
          {music.map(([number, album, artist]) => (
            <a href="#contact"><span>{number}</span><strong>{album}</strong><span>{artist}</span><span>↗</span></a>
          ))}
        </div>
      </section>

      <section class="contact shell" id="contact">
        <p class="kicker">06 / Contact</p>
        <h2>Let’s solve something interesting.</h2>
        <a href="mailto:you@example.com">you@example.com <span>↗</span></a>
      </section>
    </main>

    <footer class="footer shell">
      <p>Designed and built by Your Name</p>
      <div><a href="#top">Back to top ↑</a><span>© 2026</span></div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
        themeColor?.setAttribute('content', theme === 'dark' ? '#151614' : '#f4f2eb');
      };

      button?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    </script>
  </body>
</html>
