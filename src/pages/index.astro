---
import '../styles/global.css';

const artists = ['Sade', 'The Weeknd', 'Brent Faiyaz', "Pz'"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Ansh Maru is a Computational Mathematics student at the University of Waterloo interested in ML, AI, and backend software engineering."
    />
    <meta name="theme-color" content="#f4f2eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Ansh Maru — Computational Mathematics</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="identity" href="#top" aria-label="Home">
        <strong>AM</strong>
        <span>Computational Mathematics</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#education">Education</a>
        <a href="#about">About</a>
        <a href="#music">Listening</a>
        <span class="nav-muted">Résumé soon</span>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <span class="theme-toggle__sun" aria-hidden="true">○</span>
        <span class="theme-toggle__moon" aria-hidden="true">●</span>
      </button>
    </header>

    <main id="main">
      <section class="hero shell" id="top">
        <p class="kicker">Ansh Maru · Milton, Ontario</p>
        <h1>Computational Mathematics student interested in software engineering.</h1>
        <p class="hero__intro">
          I study at the University of Waterloo and am looking for software engineering
          internships in ML, AI, and backend development.
        </p>
        <div class="hero__footer">
          <div class="hero__actions">
            <a class="text-link" href="#work">Selected work <span>↓</span></a>
            <a class="text-link" href="mailto:you@example.com">Email <span>↗</span></a>
          </div>
          <p class="availability"><span></span> Open to opportunities</p>
        </div>
      </section>

      <section class="section shell" id="work">
        <header class="section-heading">
          <p><span>01</span> Selected work</p>
          <span>4 projects</span>
        </header>

        <div class="construction-row">
          <div>
            <h2>Project notes are being prepared.</h2>
            <p>Four projects and their technical write-ups will live here.</p>
          </div>
          <span>Under construction</span>
        </div>
      </section>

      <section class="section split-section shell" id="education">
        <div>
          <header class="section-heading"><p><span>02</span> Education</p></header>
          <article class="timeline-item">
            <time>Expected 2029</time>
            <div>
              <h2>Bachelor of Mathematics</h2>
              <p>Computational Mathematics, Honours</p>
              <p>University of Waterloo · Expected 2029</p>
            </div>
          </article>
        </div>

        <div>
          <header class="section-heading"><p><span>03</span> Direction</p></header>
          <article class="timeline-item">
            <time>Seeking</time>
            <div>
              <h2>Software engineering internships</h2>
              <p>ML and AI · Backend development</p>
              <p>Technical profile and résumé under construction.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="section about shell" id="about">
        <header class="section-heading"><p><span>04</span> About</p></header>
        <div class="about__layout">
          <p class="about__lead">I’m drawn to precise ideas and the systems that make them useful.</p>
          <div class="about__body">
            <p>
              I’m Ansh, a Computational Mathematics student with an interest in
              software engineering. A longer introduction is under construction.
            </p>
            <dl>
              <div><dt>Math</dt><dd>Cryptography · Theoretical mechanics</dd></div>
              <div><dt>Software</dt><dd>ML and AI · Backend development</dd></div>
              <div><dt>Currently</dt><dd>Under construction</dd></div>
              <div><dt>Location</dt><dd>Milton, Ontario</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="section music shell" id="music">
        <header class="section-heading"><p><span>05</span> Currently listening</p><span>Song picks coming soon</span></header>
        <div class="music-list">
          {artists.map((artist, index) => (
            <div><span>0{index + 1}</span><strong>{artist}</strong></div>
          ))}
        </div>
      </section>

      <section class="contact shell" id="contact">
        <p class="kicker">06 / Contact</p>
        <h2>Say hello.</h2>
        <a href="mailto:amaru@uwaterloo.ca">amaru@uwaterloo.ca <span>↗</span></a>
        <div class="contact__links">
          <a href="https://github.com/anshm42">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/anshmaru">LinkedIn ↗</a>
        </div>
      </section>
    </main>

    <footer class="footer shell">
      <p>Designed and built by Ansh Maru</p>
      <div><a href="#top">Back to top ↑</a><span>© 2026</span></div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
        themeColor?.setAttribute('content', theme === 'dark' ? '#151614' : '#f4f2eb');
      };

      button?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    </script>
  </body>
</html>
