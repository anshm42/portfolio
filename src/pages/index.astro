---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="ansh maru">
  <article class="markdown page home">
    <header>
      <!-- <p class="eyebrow">Ansh Maru · Milton, Ontario</p> -->
      <h1>Hi, I’m Ansh!</h1>
      <p>
        I'm a Computational Mathematics student at the University of Waterloo,
        interested in software engineering, particularly <code>ML / AI</code> and
        <code>backend systems</code>, as well as the intersection of software engineering and aviation + motorsport.
      </p>
        <p>Outside of that, I love music, history, and soccer.</p>
    </header>

    <ul class="resume-points">
      <li>
        math @ loo
        <img src="/uwaterloo.svg" alt="" title="University of Waterloo" />
      </li>
      <li>
        Built:
        <ul class="home-projects">
          {projects.map((project) => (
            <li>
              <div>
                <a href={`/work#${project.slug}`}>{project.name}</a>
                <a class="repo-link" href={project.github} target="_blank" rel="noreferrer" aria-label={`View ${project.name} on GitHub`} title="View on GitHub">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
                </a>
              </div>
              <p>{project.impact}</p>
            </li>
          ))}
        </ul>
      </li>
      <li>prev @ Pratt &amp; Whitney Canada</li>
    </ul>

    <h2>Education</h2>
    <dl class="md-definition">
      <div><dt>University</dt><dd>University of Waterloo</dd></div>
      <div><dt>Degree</dt><dd>Bachelor of Mathematics</dd></div>
      <div><dt>Program</dt><dd>Computational Mathematics, Honours</dd></div>
      <div><dt>Graduation</dt><dd>Expected 2029</dd></div>
    </dl>


    <!--
    <h2>Interests</h2>
    <ul>
      <li>Cryptography</li>
      <li>Theoretical mechanics</li>
      <li>Machine learning and AI</li>
      <li>Backend development</li>
    </ul>
    -->
  </article>
</BaseLayout>
