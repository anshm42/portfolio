---
import '../styles/global.css';

const projects = [
  {
    number: '01',
    title: 'Your strongest project',
    summary: 'Lead with the clearest example of software you designed, built, and finished.',
    idea: 'A meaningful problem',
    stack: 'Your core technologies',
    variant: 'graph',
  },
  {
    number: '02',
    title: 'A technical challenge',
    summary: 'Show how you reason through architecture, algorithms, or difficult tradeoffs.',
    idea: 'Depth and decisions',
    stack: 'Tools used with intent',
    variant: 'matrix',
  },
  {
    number: '03',
    title: 'Math meets software',
    summary: 'Connect your degree to engineering through data, modelling, or computation.',
    idea: 'Theory into practice',
    stack: 'A concise stack',
    variant: 'curve',
  },
  {
    number: '04',
    title: 'A curious experiment',
    summary: 'End with something personal that demonstrates how you explore and learn.',
    idea: 'Independent exploration',
    stack: 'Whatever fit the problem',
    variant: 'orbit',
  },
];

const music = [
  ['01', 'Album title', 'Artist'],
  ['02', 'Album title', 'Artist'],
  ['03', 'Album title', 'Artist'],
  ['04', 'Album title', 'Artist'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A mathematics student pursuing software engineering."
    />
    <meta name="theme-color" content="#f4f2eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Spline+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Mathematics → Software Engineering</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header shell">
      <a class="identity" href="#top" aria-label="Home">
        <strong>YN</strong>
        <span>Mathematics student</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a href="#music">Music</a>
        <a href="#resume">Résumé ↗</a>
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
        <span class="theme-toggle__sun" aria-hidden="true">○</span>
        <span class="theme-toggle__moon" aria-hidden="true">●</span>
      </button>
    </header>

    <main id="main">
      <section class="hero shell" id="top">
        <div class="hero__grid" aria-hidden="true"></div>
        <p class="kicker">Portfolio concept · 2026</p>
        <h1>Mathematics student<br />pursuing <em>software engineering.</em></h1>
        <div class="hero__footer">
          <p>
            I build software, study mathematical systems, and enjoy turning
            difficult problems into clear, working solutions.
          </p>
          <div class="hero__actions">
            <a class="text-link" href="#work">View projects <span>↓</span></a>
            <a class="text-link" href="mailto:you@example.com">Email <span>↗</span></a>
          </div>
          <p class="availability"><span></span> Open to opportunities</p>
        </div>
      </section>

      <section class="section shell" id="work">
        <header class="section-heading">
          <p><span>01</span> Selected work</p>
          <span>4 projects</span>
        </header>

        <div class="projects">
          {projects.map((project, index) => (
            <article class:list={['project', { 'project--featured': index === 0 }]}>
              <div class="project__copy">
                <p class="project__number">{project.number} / Sample content</p>
                <h2>{project.title}</h2>
                <p class="project__summary">{project.summary}</p>
                <dl>
                  <div><dt>Idea</dt><dd>{project.idea}</dd></div>
                  <div><dt>Built with</dt><dd>{project.stack}</dd></div>
                </dl>
                <a class="text-link" href="#contact">Case study coming soon <span>↗</span></a>
              </div>

              <div class:list={['project-art', `project-art--${project.variant}`]} aria-hidden="true">
                <span class="art-label">{project.number}</span>
                {project.variant === 'graph' && (
                  <svg viewBox="0 0 600 360" role="presentation">
                    <g class="edges">
                      <path d="M100 250 205 95 330 220 485 90" />
                      <path d="M100 250 330 220 505 275" />
                      <path d="M205 95 485 90 505 275" />
                    </g>
                    <g class="nodes">
                      <circle cx="100" cy="250" r="13" /><circle cx="205" cy="95" r="13" />
                      <circle cx="330" cy="220" r="18" /><circle cx="485" cy="90" r="13" />
                      <circle cx="505" cy="275" r="13" />
                    </g>
                  </svg>
                )}
                {project.variant === 'matrix' && <div class="matrix">{Array.from({ length: 36 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>}
                {project.variant === 'curve' && <svg viewBox="0 0 600 360"><path class="axis" d="M60 300H550M80 330V35"/><path class="plot" d="M80 270C150 260 175 55 255 90S340 315 425 235 475 60 550 75"/></svg>}
                {project.variant === 'orbit' && <div class="orbit"><i></i><i></i><i></i></div>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split-section shell" id="experience">
        <div>
          <header class="section-heading"><p><span>02</span> Experience</p></header>
          <article class="timeline-item">
            <time>20XX—NOW</time>
            <div><h2>Your role</h2><p>Company or organisation</p><p>Describe what you contributed and the result, not just the tasks you were given.</p></div>
          </article>
          <article class="timeline-item muted-item">
            <time>20XX</time>
            <div><h2>Another relevant role</h2><p>Company or organisation</p></div>
          </article>
        </div>

        <div>
          <header class="section-heading"><p><span>03</span> Education</p></header>
          <article class="timeline-item">
            <time>20XX—20XX</time>
            <div><h2>BSc Mathematics</h2><p>Your university</p><p>Probability · Statistics · Numerical methods · Graph theory</p></div>
          </article>
        </div>
      </section>

      <section class="section about shell" id="about">
        <header class="section-heading"><p><span>04</span> About</p></header>
        <div class="about__layout">
          <p class="about__lead">I like problems that need both careful reasoning and practical execution.</p>
          <div class="about__body">
            <p>
              Use this space to explain how mathematics shapes the way you build software:
              breaking down unfamiliar problems, reasoning precisely, and communicating complex ideas clearly.
            </p>
            <dl>
              <div><dt>Focus</dt><dd>Your engineering interests</dd></div>
              <div><dt>Currently</dt><dd>What you are learning</dd></div>
              <div><dt>Location</dt><dd>Your city or region</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="section music shell" id="music">
        <header class="section-heading"><p><span>05</span> Currently in rotation</p><span>After-hours listening</span></header>
        <div class="music-list">
          {music.map(([number, album, artist]) => (
            <a href="#contact"><span>{number}</span><strong>{album}</strong><span>{artist}</span><span>↗</span></a>
          ))}
        </div>
      </section>

      <section class="contact shell" id="contact">
        <p class="kicker">06 / Contact</p>
        <h2>Let’s solve something<br /><em>interesting.</em></h2>
        <a href="mailto:you@example.com">you@example.com <span>↗</span></a>
      </section>
    </main>

    <footer class="footer shell">
      <p>Designed and built by Your Name</p>
      <div><a href="#top">Back to top ↑</a><span>© 2026</span></div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const setTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
        themeColor?.setAttribute('content', theme === 'dark' ? '#151614' : '#f4f2eb');
      };

      button?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    </script>
  </body>
</html>
